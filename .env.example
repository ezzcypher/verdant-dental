# Copy to .env and fill in real values. .env is gitignored — never commit it.
# Validation happens on first request (not at build time), and the app returns a
# single aggregated error naming every variable that is missing or malformed.

# ── PostgreSQL (Neon, Supabase, or any Postgres) ──────────────────────────────
# Two strings from the SAME database:
#   DATABASE_URL = the POOLED connection (host contains "-pooler")  → app runtime
#   DIRECT_URL   = the DIRECT connection (no "-pooler")             → db push / migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/dental?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/dental?sslmode=require"

# ── Session + privacy ─────────────────────────────────────────────────────────
# Signing key for the admin session cookie. >= 32 chars of high-entropy random.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="replace-with-96-hex-chars-of-random"

# Salt for hashing client IPs before they touch the database. >= 16 chars.
# The raw IP is never stored or logged — only sha256(ip + salt), for abuse triage.
IP_HASH_SALT="replace-with-48-hex-chars-of-random"

# scrypt hash of the single admin password. The plaintext is never stored.
#   npm run admin:hash -- 'your-strong-admin-password'
ADMIN_PASSWORD_HASH="scrypt:16384:<salt-hex>:<hash-hex>"

# Optional: extra origins allowed to call mutating API routes (comma-separated).
# Same-origin is always allowed — leave blank normally.
ALLOWED_ORIGINS=""

# ── AI receptionist (optional) ────────────────────────────────────────────────
# With no key the chatbot runs its deterministic rule-based engine: it still
# answers from the knowledge base and completes real bookings. With a key it
# runs Claude, and falls back to the rule-based engine on any API error — so the
# widget never dies in front of a patient.
# ANTHROPIC_API_KEY="sk-ant-..."
# AI_MODEL="claude-opus-5"   # default; any Claude model id works
