// Prisma schema — PostgreSQL (Neon).
//
// First-time setup (after `npm install`, with DATABASE_URL + DIRECT_URL set):
//   npm run db:push     # create the tables
//   npm run db:seed     # load treatments, dentists and the knowledge base
//
// Nothing is written to the local filesystem, so this runs identically on
// Vercel's ephemeral serverless filesystem.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled connection (app runtime)
  directUrl = env("DIRECT_URL") // direct connection (db push / migrations)
}

/// A public appointment request. Contains PII (name + phone, optional email),
/// so it is only ever readable through the authenticated admin API.
model Appointment {
  id                  String       @id @default(cuid())
  reference           String       @unique // short human-facing code, e.g. VD-7F3K2Q
  name                String
  phone               String
  email               String?
  treatment           String
  note                String?
  reasonForVisit      String?
  preferredDate       String? // free text exactly as the patient gave it
  preferredTime       String?
  conversationSummary String? // short summary when the request came from the chatbot
  source              String       @default("web") // web | chatbot
  status              String       @default("pending") // pending | confirmed | cancelled | completed
  sourceIpHash        String? // sha256(ip + IP_HASH_SALT) — abuse triage only, never the raw IP
  chatSession         ChatSession? @relation(fields: [chatSessionId], references: [id], onDelete: SetNull)
  chatSessionId       String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([createdAt])
  @@index([status])
  @@index([source])
}

/// A general contact-form message. Also PII; admin-only.
model ContactMessage {
  id           String   @id @default(cuid())
  name         String
  email        String
  subject      String?
  body         String
  handled      Boolean  @default(false)
  sourceIpHash String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

/// Opaque server-side session for the single admin operator. The cookie holds a
/// random token; only its SHA-256 hash is stored, so a database leak does not
/// yield usable sessions. Deleting the row is a real logout (revocation).
model AdminSession {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  userAgent  String?

  @@index([expiresAt])
}

/// ─────────────────────────────────────────────────────────────
/// AI dental receptionist
/// ─────────────────────────────────────────────────────────────

/// One browser chat conversation. `publicId` is what the client holds; the
/// internal `id` is never exposed. Carries the running "collected" patient
/// details so the receptionist never re-asks for something already given.
model ChatSession {
  id             String   @id @default(cuid())
  publicId       String   @unique
  status         String   @default("active") // active | converted | closed
  leadStatus     String   @default("browsing") // browsing | interested | booking | converted
  patientName    String?
  preferredDentist String?
  treatment      String?
  preferredDate  String?
  preferredTime  String?
  contactPhone   String?
  contactEmail   String?
  reasonForVisit String?
  summary        String? // short running summary for the admin
  urgentFlag     Boolean  @default(false) // dental emergency detected
  sourceIpHash   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  lastActivityAt DateTime @default(now())

  messages     ChatMessage[]
  appointments Appointment[]

  @@index([leadStatus])
  @@index([lastActivityAt])
}

model ChatMessage {
  id        String      @id @default(cuid())
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId String
  role      String // user | assistant
  content   String
  createdAt DateTime    @default(now())

  @@index([sessionId, createdAt])
}

/// Editable clinic knowledge the receptionist answers from. Admin-editable, so
/// the clinic can correct the bot without a redeploy.
model KnowledgeItem {
  id        String   @id @default(cuid())
  slug      String   @unique
  category  String // clinic | hours | location | contact | policy | faq | aftercare | insurance
  title     String
  content   String
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, sortOrder])
}

/// A bookable treatment with its price — the bot quotes from this table, so
/// prices are never hallucinated and never go stale in the prompt.
model Treatment {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String   @default("general") // general | cosmetic | orthodontics | surgical | emergency
  description String?
  priceFrom   String? // display string, e.g. "from $850"
  duration    String? // e.g. "45–60 min"
  keywords    String? // comma-separated symptom/topic keywords for triage matching
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sortOrder])
}

model Dentist {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  title           String // e.g. "Lead Prosthodontist"
  focus           String? // what they treat
  bio             String?
  yearsExperience Int?
  languages       String?
  photo           String?
  active          Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([sortOrder])
}
